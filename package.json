{
  "name": "budgetapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite dev --config web/vite.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "pretest": "node -e \"require('fs').mkdirSync('web/dist',{recursive:true}); if(!require('fs').existsSync('web/dist/index.html')) require('fs').writeFileSync('web/dist/index.html','<!-- placeholder: run npm run build for the real app -->')\"",
    "test": "vitest run",
    "build": "vite build --config web/vite.config.ts",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply budgetapp-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply budgetapp-db --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "globals": "^17.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
