{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // worker-configuration.d.ts (below, generated by `wrangler types` /
    // `npm run cf-typegen`) supplies both the ambient runtime types (Request,
    // D1Database, ExecutionContext, ...) and the global `Env` interface, so
    // @cloudflare/workers-types isn't referenced directly. `/types` is the
    // `cloudflare:test` module declaration used by test/**.
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "outDir": "./.tsbuild/worker"
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
