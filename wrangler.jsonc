{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budgetapp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ae27b7c9ac758e8d19425d6bbfaa127f",

  // Single Worker serves both the API (/api/*, routed to Hono) and the SPA
  // (everything else, falling through to the built web/dist assets). One
  // deploy, one origin, no CORS.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // EMAIL_FROM is a plain var, not a `wrangler secret put` value — it's not
  // sensitive, and a committed var is reviewable, same treatment as
  // ENVIRONMENT. See docs/plan.md's PR 11 notes.
  "vars": {
    "ENVIRONMENT": "production",
    "EMAIL_FROM": "noreply@budget.naught.ca"
  },

  // Production. Bound as `DB`. Migrations applied on every `main` deploy —
  // see the "main deploy" command in the plan / README.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budgetapp-db",
      "database_id": "8929286f-b8c1-44c3-9579-0636ba5684ad",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Email Service (public beta) — real magic-link delivery for
  // arbitrary recipients, gated on the account's paid Workers plan. Not
  // the older Email Routing send_email binding, which only reaches
  // pre-verified destination addresses and can't do this job — see
  // docs/plan.md's PR 11 notes. No `remote: true`: local `wrangler dev`
  // and tests hit Miniflare's local simulation, never the real API — only
  // a real `wrangler deploy` does. Repeated (with a different EMAIL_FROM)
  // in env.stg and env.uat below, same reasoning throughout.
  "send_email": [{ "name": "EMAIL" }],

  // Per-IP throttle on the magic-link request endpoint (blunt scripted-abuse
  // protection; the meaningful "don't spam this inbox" limit is our own
  // cooldown against auth_tokens — see src/auth/rate-limit.ts). Cloudflare's
  // native binding only offers 10s/60s windows, hence the two-layer design.
  // namespace_id is a self-chosen identifier, not a resource that needs
  // pre-provisioning — distinct per environment below so they don't share
  // a bucket. Not inherited by named environments, so repeated per env.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],

  "env": {
    // stg shares the PRODUCTION database on purpose (see plan: "Environments
    // & deployment" — stg proves app-only changes against real data). Its
    // deploy command therefore runs scripts/assert-schema-current.mjs
    // instead of applying migrations, and never runs migrations here.
    "stg": {
      "name": "budgetapp-stg",
      "vars": { "ENVIRONMENT": "staging", "EMAIL_FROM": "noreply@budget-stg.naught.ca" },
      "assets": {
        "directory": "./web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      },
      // migrations_dir is present (unlike the original design) so
      // `wrangler d1 migrations apply --env stg` can actually run. stg no
      // longer NEVER applies migrations — see CLAUDE.md's "Deployment
      // process": an additive (expand-only) migration is applied here too,
      // ahead of prod, as an extra checkpoint against real data. Only a
      // migration judged to break the currently-live prod code skips this
      // env, and even then nothing here stops it mechanically — that
      // judgment call is a documented human/agent decision, not a config
      // flag, because it depends on reading the migration's SQL.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "budgetapp-db",
          "database_id": "8929286f-b8c1-44c3-9579-0636ba5684ad",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }]
    },

    // uat gets its OWN database, so schema changes get a real rehearsal
    // before they ever touch prod data (via stg) or prod itself (via main).
    "uat": {
      "name": "budgetapp-uat",
      "vars": { "ENVIRONMENT": "uat", "EMAIL_FROM": "noreply@budget-uat.naught.ca" },
      "assets": {
        "directory": "./web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "budgetapp-uat-db",
          "database_id": "cb0e0695-661a-4a29-ac48-97bbaf12dbad",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
      ],
      // See the top-level send_email comment above.
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
